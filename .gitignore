# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# venv
venv/

# Frontend
frontend/node_modules/
frontend/dist/

# Runtime artifacts (regenerated on every analysis)
uploads/*
!uploads/.gitkeep
cleaned/*
