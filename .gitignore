*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz

# OS
.DS_Store

# Reports — keep the whitepaper, ignore the auto-generated dataset PDFs
reports/*_report.pdf
reports/whitepaper/*.aux
reports/whitepaper/*.log
reports/whitepaper/*.out
reports/whitepaper/*.toc

# IDE
.vscode/
.idea/
.kiro/
