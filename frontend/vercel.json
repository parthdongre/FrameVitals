{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://datalens-ai-backend.onrender.com/api/$1" },
    { "source": "/static/(.*)", "destination": "https://datalens-ai-backend.onrender.com/static/$1" },
    { "source": "/download-cleaned/(.*)", "destination": "https://datalens-ai-backend.onrender.com/download-cleaned/$1" },
    { "source": "/download-report/(.*)", "destination": "https://datalens-ai-backend.onrender.com/download-report/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
